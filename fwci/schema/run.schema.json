{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fwci-run/1",
  "title": "One CI run of a firmware component on hardware and in host checks",
  "type": "object",
  "required": [
    "schema",
    "project",
    "run",
    "state",
    "host_checks",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "fwci-run/1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "created",
        "updated",
        "base"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "nightly",
            "series",
            "pin-candidate",
            "adhoc"
          ]
        },
        "title": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "ci_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "base": {
          "$ref": "#/$defs/source"
        },
        "series": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "message_id"
          ],
          "additionalProperties": false,
          "properties": {
            "message_id": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "link": {
              "type": "string"
            }
          }
        },
        "baseline": {
          "type": [
            "string",
            "null"
          ],
          "description": "run id this run is compared with"
        },
        "stack": {
          "type": "array",
          "description": "series applied onto the base, in order (ad-hoc and series runs)",
          "items": {
            "type": "object",
            "required": [
              "message_id",
              "version",
              "patches",
              "title",
              "applied"
            ],
            "additionalProperties": false,
            "properties": {
              "message_id": {
                "type": "string"
              },
              "link": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "patches": {
                "type": "integer",
                "minimum": 1
              },
              "applied": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "added_as_prerequisite_of": {
                "type": "string"
              },
              "failed_patch": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "number": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "subject": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              "unresolved_prerequisites": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "note": {
      "type": "string"
    },
    "linux": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "tag",
        "commit",
        "release",
        "image_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^next-[0-9]{8}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "image_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "modules_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "host_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "queued",
              "running"
            ]
          },
          "summary": {
            "type": "string"
          },
          "log": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "boot_time_reference": {
      "type": "object",
      "required": [
        "version",
        "tool",
        "source",
        "boards"
      ],
      "additionalProperties": false,
      "description": "the stock reference: per board, the newest lab health checks (the downstream firmware booting its own image) before this run, one power-on boot each",
      "properties": {
        "version": {
          "const": 1
        },
        "tool": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "boards": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "device_type",
              "boots"
            ],
            "additionalProperties": false,
            "properties": {
              "device_type": {
                "type": "string"
              },
              "boots": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference_boot"
                }
              },
              "median": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "queued",
        "building",
        "flashing",
        "testing",
        "done",
        "skipped",
        "error",
        "cancelled"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "skip",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "under-test",
            "pinned",
            "stock",
            "payload"
          ]
        },
        "repo": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "upstream": {
          "type": [
            "object",
            "null"
          ],
          "description": "distance to upstream: patches this pin carries that upstream does not have",
          "required": [
            "base",
            "distance",
            "carried"
          ],
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "distance": {
              "type": "integer",
              "minimum": 0
            },
            "carried": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "commit",
                  "subject"
                ],
                "additionalProperties": false,
                "properties": {
                  "commit": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "review": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "origin": {
          "enum": [
            "upstream",
            "downstream"
          ],
          "description": "where the component comes from, for the boot chain view"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "link to the exact commit"
        },
        "pending": {
          "type": "string",
          "description": "why the pinned commit cannot be fetched yet"
        },
        "soc_branch": {
          "type": "object",
          "required": [
            "name",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "files": {
          "type": "array",
          "description": "downstream archives: download link and sha256",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "layers": {
          "type": "array",
          "description": "meta layer commits a downstream pin was read at",
          "items": {
            "type": "object",
            "required": [
              "name",
              "commit"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "repo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recipes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "configs": {
          "type": "array",
          "description": "U-Boot configs in build order; used false on an optional one is a board fragment the base does not have",
          "items": {
            "type": "object",
            "required": [
              "name",
              "optional",
              "used"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "used": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "device_tree": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "dtbs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "dtb_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "boottime_case": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "repo",
            "commit"
          ],
          "description": "payload: the on-target boot-time case the UKI carries (test-definitions repo, commit with its link, sha256 of each file packed)",
          "properties": {
            "repo": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/sha256"
              }
            },
            "cpio_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "suite",
        "name",
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "suite": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "url": {
          "type": "string"
        },
        "flake": {
          "type": "string",
          "description": "flake list entry id when this case is a known flake"
        },
        "note": {
          "type": "string"
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "console lines a failed shell check printed (dmesg-errors: the kernel errors left)"
        }
      }
    },
    "linux_boot": {
      "type": "object",
      "required": [
        "verdict",
        "stage"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ]
        },
        "stage": {
          "enum": [
            "login",
            "nothing-booted",
            "no-efi-stub",
            "hang-before-console",
            "early-panic",
            "no-login",
            "not-reached"
          ]
        },
        "detail": {
          "type": "string"
        },
        "last_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "versus_baseline": {
          "enum": [
            "regression",
            "upstream-gap",
            "fixed",
            "same",
            "unknown"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "board",
        "stack",
        "state"
      ],
      "if": {
        "properties": {
          "state": {
            "enum": [
              "skipped",
              "error",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "state_detail"
        ],
        "properties": {
          "state_detail": {
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "properties": {
        "board": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "state_detail": {
          "type": "string"
        },
        "queue_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fingerprint": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "lava": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "job_id",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "job_id": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            },
            "device": {
              "type": [
                "string",
                "null"
              ]
            },
            "health": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "fingerprint_gate": {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ]
        },
        "linux_boot": {
          "$ref": "#/$defs/linux_boot"
        },
        "restore": {
          "description": "legacy, documents before 2026-10-25: the end-of-job lab firmware restore; jobs no longer restore",
          "enum": [
            "pass",
            "fail",
            "not-run",
            "recovery-job"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "diff": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "new_fail": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "new_pass": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "still_fail": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "recovery": {
          "type": "object",
          "required": [
            "job_id",
            "url"
          ],
          "additionalProperties": false,
          "description": "legacy, documents before 2026-10-25: the job that put the lab image back after this target's job stopped before its own restore",
          "properties": {
            "job_id": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            },
            "health": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "boot_chain": {
          "type": "array",
          "description": "every boot stage, upstream or downstream",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "origin"
            ],
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "upstream",
                  "downstream",
                  "none"
                ]
              },
              "component": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "spl": {
          "type": "object",
          "additionalProperties": false,
          "description": "SPL-stack targets: the series in flight that add SPL support for the board and the known gaps, shown whatever the result",
          "required": [
            "in_flight",
            "gaps"
          ],
          "properties": {
            "in_flight": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "message_id",
                  "link"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer"
                  },
                  "message_id": {
                    "type": "string"
                  },
                  "link": {
                    "type": "string"
                  }
                }
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "boot_time": {
          "$ref": "#/$defs/boot_time"
        }
      }
    },
    "boot_stage": {
      "type": "object",
      "required": [
        "t",
        "line",
        "replayed"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "number",
          "description": "seconds after the boot's reference, as LAVA stamped the console line"
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based LAVA log entry index (#L link)"
        },
        "replayed": {
          "type": "boolean",
          "description": "the line came in console backlog: its time only bounds the stage from above and is never compared"
        }
      }
    },
    "boot": {
      "type": "object",
      "required": [
        "kind",
        "ref_line",
        "url",
        "complete",
        "last_stage",
        "stages"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "first",
            "cold",
            "warm-reset",
            "warm-reboot"
          ],
          "description": "first: the job's first power-on (after its flash); cold: a later power-on; warm-reset: after U-Boot's reset command; warm-reboot: after the kernel's reboot"
        },
        "ref_line": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "complete": {
          "type": "boolean",
          "description": "the login prompt arrived"
        },
        "last_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "reset": {
          "type": [
            "number",
            "null"
          ],
          "description": "seconds after the reference at which the boot started over without a power command (watchdog, firmware reset)"
        },
        "fastboot": {
          "type": "boolean",
          "description": "the kernel was sent over fastboot: Linux includes the download"
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/boot_stage"
          }
        }
      }
    },
    "boot_time": {
      "type": "object",
      "required": [
        "version",
        "tool",
        "boots",
        "headline"
      ],
      "additionalProperties": false,
      "description": "per-stage boot times of the target's LAVA job (fwci/boottime.py)",
      "properties": {
        "version": {
          "const": 1
        },
        "tool": {
          "type": "string",
          "description": "the parser that measured, with its commit"
        },
        "boots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boot"
          }
        },
        "headline": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "index of the cold boot the target is judged by, null when the job had none"
        },
        "on_target": {
          "type": "object",
          "required": [
            "suite",
            "case",
            "boot",
            "finished",
            "cases"
          ],
          "additionalProperties": false,
          "description": "the on-target boot-time case: times from the kernel's own clock, a separate view from the host-side boots",
          "properties": {
            "suite": {
              "type": "string"
            },
            "case": {
              "type": "string"
            },
            "boot": {
              "type": [
                "integer",
                "null"
              ]
            },
            "finished": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "result"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "result": {
                    "enum": [
                      "pass",
                      "fail",
                      "skip"
                    ]
                  },
                  "value": {
                    "type": "number"
                  },
                  "units": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "versus_baseline": {
          "type": "object",
          "additionalProperties": false,
          "description": "per boot kind, against the same board and stack of the baseline run",
          "properties": {
            "baseline": {
              "type": [
                "string",
                "null"
              ]
            },
            "kinds": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "verdict"
                ],
                "additionalProperties": false,
                "properties": {
                  "verdict": {
                    "enum": [
                      "regression",
                      "improvement",
                      "same",
                      "stopped-earlier",
                      "no-history",
                      "unknown"
                    ]
                  },
                  "stage": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "now": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "then": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "delta": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "threshold": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "noise": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "history": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "stages": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "now": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "then": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "delta": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "threshold": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "verdict": {
                          "enum": [
                            "regression",
                            "improvement",
                            "same",
                            "no-history",
                            "unknown"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "reference_boot": {
      "type": "object",
      "required": [
        "kind",
        "ref_line",
        "url",
        "complete",
        "last_stage",
        "stages",
        "job",
        "job_url"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "first",
            "cold",
            "warm-reset",
            "warm-reboot"
          ],
          "description": "first: the job's first power-on (after its flash); cold: a later power-on; warm-reset: after U-Boot's reset command; warm-reboot: after the kernel's reboot"
        },
        "ref_line": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string"
        },
        "complete": {
          "type": "boolean",
          "description": "the login prompt arrived"
        },
        "last_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "reset": {
          "type": [
            "number",
            "null"
          ],
          "description": "seconds after the reference at which the boot started over without a power command (watchdog, firmware reset)"
        },
        "fastboot": {
          "type": "boolean",
          "description": "the kernel was sent over fastboot: Linux includes the download"
        },
        "stages": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/boot_stage"
          }
        },
        "job": {
          "type": "integer"
        },
        "job_url": {
          "type": "string"
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_time": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
